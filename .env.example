KNOWLEDGE_UPLOAD_MAX_BYTES=26214400
# Optional external identity provider; no identity server is bundled.
OIDC_ISSUER=
OIDC_JWKS_URL=
OIDC_AUDIENCE=semora-web
AUTH_REQUIRED=false

# External WeKnora provides document parsing and Wiki retrieval.
# Semora controls the requirement-understanding and SQL workflow.
SEMORA_WEKNORA_BASE_URL=https://your-weknora.example.com/api/v1
SEMORA_WEKNORA_API_KEY=
WEKNORA_AGENT_ID=builtin-wiki-researcher
WEKNORA_AGENT_TIMEOUT_SECONDS=180

# Local host ports. Defaults avoid the AskOda demo ports when both projects run.
SEMORA_POSTGRES_PORT=15433
VITE_KEYCLOAK_URL=http://localhost:8088
INTERNAL_TOKEN=semora-dev-internal
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_MODE=optional
LLM_TIMEOUT_SECONDS=300
LLM_REQUEST_RETRIES=1
LLM_STREAM_ENABLED=true
LLM_STREAM_INCLUDE_USAGE=true
# Empty: provider default. Set false to disable thinking on supported models.
LLM_ENABLE_THINKING=false
LLM_NO_DELIVERY_SECONDS=60
AGENT_MAX_NO_PROGRESS=3
AGENT_TIMEOUT_SECONDS=900
AGENT_CONTEXT_MAX_BYTES=256000
AGENT_ANALYST_CONTEXT_MAX_BYTES=131072

# Optional 51talk source credentials: injected into Executor only.

SEMORA_DEBUG_PAYLOADS=false
# Model-authored PostgreSQL SQL -> dialect adapter -> database validation.

# Metadata scan statement budget and Executor fallbacks when no query policy is sent.
SCAN_TIMEOUT_MS=60000
QUERY_TIMEOUT_MS=30000
MAX_RESULT_ROWS=1000
MAX_RESULT_BYTES=10485760
RELATIONSHIP_PROFILE_TIMEOUT_MS=30000

RELATIONSHIP_MODEL_CONCURRENCY=3

# Oversized keyword groups use autonomous tools; ordinary groups retain batch comparison.
RELATIONSHIP_AGENT_GROUP_THRESHOLD=40
RELATIONSHIP_COMPARISON_TASK_THRESHOLD=30
RELATIONSHIP_AGENT_MAX_STEPS=8

RELATIONSHIP_NO_DELIVERY_SECONDS=300

# Use text / omit for compatible local services without JSON mode or thinking options.
RELATIONSHIP_RESPONSE_FORMAT=json_object
RELATIONSHIP_THINKING_MODE=inherit
